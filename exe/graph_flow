#!/usr/bin/env ruby
# frozen_string_literal: true

require "graph_flow"

case ARGV[0]
when "mcp"
  tools = [
    GraphFlow::Tools::GetFlow,
    GraphFlow::Tools::UpdateFlow,
    GraphFlow::Tools::StoreFlowDiagram,
    GraphFlow::Tools::GetNodeCode,
    GraphFlow::Tools::UpdateNodeCode
  ]

  server = MCP::Server.new(name: "graph_flow", tools: tools)
  transport = MCP::Server::Transports::StdioTransport.new(server)
  transport.open
when "install"
  begin
    GraphFlow::Installer.new.run(ARGV[1])
  rescue ArgumentError => e
    warn e.message
    exit 1
  end
when "prune"
  GraphFlow::Pruner.new.run
else
  warn "Usage: graph_flow mcp|install copilot|claude|prune"
  exit 1
end

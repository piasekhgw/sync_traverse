#!/usr/bin/env ruby
# frozen_string_literal: true

require "graph_flow"

case ARGV[0]
when "mcp"
  tools = [
    GraphFlow::Tools::GetFlow,
    GraphFlow::Tools::AddSingleNode,
    GraphFlow::Tools::RemoveSingleNode,
    GraphFlow::Tools::AddEdges,
    GraphFlow::Tools::RemoveEdges,
    GraphFlow::Tools::RemoveFlow,
    GraphFlow::Tools::GetNodeCode,
    GraphFlow::Tools::UpsertNodeCode,
    GraphFlow::Tools::RemoveNodeCode
  ]

  server = MCP::Server.new(name: "graph_flow", tools: tools)
  transport = MCP::Server::Transports::StdioTransport.new(server)
  transport.open
else
  warn "Usage: graph_flow mcp"
  exit 1
end

#!/usr/bin/env ruby
# frozen_string_literal: true

require "sync_traverse"

USAGE = <<~TEXT
  Usage:
    sync_traverse install copilot|claude
    sync_traverse mcp
TEXT

case ARGV.shift
when "mcp"
  tools = [
    SyncTraverse::Tools::GetFlow,
    SyncTraverse::Tools::UpdateFlow,
    SyncTraverse::Tools::GetAction,
    SyncTraverse::Tools::UpdateAction,
    SyncTraverse::Tools::RunTests
  ]

  server = MCP::Server.new(name: "sync_traverse", tools: tools)
  transport = MCP::Server::Transports::StdioTransport.new(server)
  transport.open
when "install"
  begin
    SyncTraverse::Installer.new.call(ARGV.first)
  rescue ArgumentError => e
    abort e.message
  end
else
  abort USAGE
end

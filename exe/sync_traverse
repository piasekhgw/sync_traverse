#!/usr/bin/env ruby
# frozen_string_literal: true

require "sync_traverse"
require "optparse"

USAGE = <<~TEXT
  Usage:
    sync_traverse install copilot|claude --nodes-dir DIR --flows-dir DIR --node-tests-dir DIR
    sync_traverse mcp
TEXT

def parse_paths(argv)
  paths = {}
  OptionParser.new do |parser|
    parser.on("--nodes-dir DIR") { |dir| paths[:nodes_dir] = dir }
    parser.on("--flows-dir DIR") { |dir| paths[:flows_dir] = dir }
    parser.on("--node-tests-dir DIR") { |dir| paths[:node_tests_dir] = dir }
  end.parse!(argv)

  missing = %i[nodes_dir flows_dir node_tests_dir] - paths.keys
  abort "Missing option(s): #{missing.map { |name| "--#{name.to_s.tr("_", "-")}" }.join(", ")}\n\n#{USAGE}" if missing.any?

  paths
rescue OptionParser::ParseError => e
  abort "#{e.message}\n\n#{USAGE}"
end

case ARGV.shift
when "mcp"
  begin
    SyncTraverse.config
  rescue SyncTraverse::Config::Error => e
    abort e.message
  end

  tools = [
    SyncTraverse::Tools::GetFlow,
    SyncTraverse::Tools::UpdateFlow,
    SyncTraverse::Tools::StoreFlowDiagram,
    SyncTraverse::Tools::GetNodeCode,
    SyncTraverse::Tools::UpdateNodeCode,
    SyncTraverse::Tools::PruneNodes,
    SyncTraverse::Tools::RunNodeTests
  ]

  server = MCP::Server.new(name: "sync_traverse", tools: tools)
  transport = MCP::Server::Transports::StdioTransport.new(server)
  transport.open
when "install"
  paths = parse_paths(ARGV)
  begin
    SyncTraverse::Installer.new.call(ARGV.first, **paths)
  rescue ArgumentError => e
    abort e.message
  end
else
  abort USAGE
end

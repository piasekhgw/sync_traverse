[
  {
    "name": "get_flow",
    "description": "Returns the complete current flow. Call this before modifying an existing flow.",
    "parameters": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "create_single_node_flow",
    "description": "Creates a new flow consisting of exactly one node and no edges. Use only when the complete flow has one node.",
    "parameters": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string",
          "description": "The snake_case node name."
        }
      },
      "required": ["node"]
    }
  },
  {
    "name": "add_edges",
    "description": "Adds edges to the flow. Referenced nodes are created automatically.",
    "parameters": {
      "type": "object",
      "properties": {
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "description": "Source node name."
              },
              "target": {
                "type": "string",
                "description": "Target node name."
              },
              "source_outcome": {
                "type": "string",
                "description": "Outcome returned by the source node that selects this edge."
              }
            },
            "required": [
              "source",
              "target",
              "source_outcome"
            ]
          }
        }
      },
      "required": ["edges"]
    }
  },
  {
    "name": "remove_edges",
    "description": "Removes existing edges from the flow.",
    "parameters": {
      "type": "object",
      "properties": {
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "source_outcome": {
                "type": "string"
              }
            },
            "required": [
              "source",
              "target",
              "source_outcome"
            ]
          }
        }
      },
      "required": ["edges"]
    }
  }
]
